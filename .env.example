# 数据库连接（必填）
# SQLite: sqlite:./data/ingjoo.db?mode=rwc
# PostgreSQL: postgres://user:pass@localhost:5432/ingjoo_dev
DATABASE_URL=sqlite:./data/ingjoo.db?mode=rwc

# 服务端口
PORT=3000

# CORS 允许的源（* 表示全部允许）
CORS_ORIGIN=*

# 日志级别: trace, debug, info, warn, error
RUST_LOG=ingjoo_bin=debug

# JWT 配置（生产环境务必替换）
# JWT_SECRET=your-secret-key-here
# JWT_ACCESS_TTL=900
# JWT_REFRESH_TTL=604800
